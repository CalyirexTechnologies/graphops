# Copy to .env and fill in. Nothing in this file is read automatically:
# the application reads the process environment, so the operator decides how
# these arrive (systemd, Docker, ECS task definition, direnv).

# ---------------------------------------------------------------- required
# No default exists. The process refuses to start without it.
# Generate with: graphops keygen
GRAPHOPS_SIGNING_KEY=

# ---------------------------------------------------------------- optional
GRAPHOPS_ENV=development
GRAPHOPS_DB_PATH=data/graphops.db
GRAPHOPS_LOG_FORMAT=json
GRAPHOPS_LOG_LEVEL=INFO
GRAPHOPS_RATE_LIMIT=120

# replay reads the committed fixtures and needs no vendor account.
# live issues real API calls and refuses to start without the credentials
# for each connector enabled. It never falls back to the fixtures.
GRAPHOPS_CONNECTOR_MODE=replay

# Traversal bounds. A caller cannot raise these.
GRAPHOPS_MAX_PATH_DEPTH=6
GRAPHOPS_MAX_PATHS=500
GRAPHOPS_MAX_NODES=50000

# ------------------------------------------------------------- graph store
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -------------------------------------------------- connectors (live mode)
# Only needed for the connectors you actually enable.

# Splunk Enterprise Security
SPLUNK_HOST=
SPLUNK_TOKEN=

# Microsoft Sentinel and Entra ID. The client ID and secret are exchanged
# for a token with Microsoft identity. SENTINEL_WORKSPACE_ID is the
# workspace's full resource ID, /subscriptions/.../workspaces/<name>.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=
# National clouds only:
# AZURE_LOGIN_URL=https://login.microsoftonline.com
# AZURE_MANAGEMENT_URL=https://management.azure.com
# GRAPH_URL=https://graph.microsoft.com

# CrowdStrike Falcon. Exchanged for a token at /oauth2/token.
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
# US-2, EU-1 and GovCloud customers:
# FALCON_BASE_URL=https://api.crowdstrike.com

# Okta
OKTA_DOMAIN=
OKTA_API_TOKEN=

# AWS CloudTrail. The directory your trail's S3 bucket is synced to,
# e.g. by `aws s3 sync s3://<trail-bucket>/AWSLogs ./cloudtrail`.
CLOUDTRAIL_LOG_DIR=

# Qualys VMDR
QUALYS_API_URL=
QUALYS_USERNAME=
QUALYS_PASSWORD=

# Tenable.io
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# ServiceNow
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Outbound
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
